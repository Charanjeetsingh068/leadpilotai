  ctr               Float             @default(0.0)
  leadsCount        Int               @default(0)
  cpl               Float             @default(0.0)
  conversions       Int               @default(0)
  roas              Float             @default(0.0)
  status            String            @default("ACTIVE")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@map("facebook_ads")
}

model FacebookInsight {
  id                String           @id @default(uuid()) @db.Uuid
  facebookAccountId String           @db.Uuid
  facebookAccount   FacebookAccount  @relation(fields: [facebookAccountId], references: [id], onDelete: Cascade)
  facebookPageId    String?          @db.Uuid
  facebookPage      FacebookPage?    @relation(fields: [facebookPageId], references: [id], onDelete: SetNull)
  date              DateTime         @default(now())
  period            String           @default("DAILY") // DAILY, WEEKLY, MONTHLY
  leadsCount        Int              @default(0)
  spend             Float            @default(0.0)
  ctr               Float            @default(0.0)
  reach             Int              @default(0)
  impressions       Int              @default(0)
  frequency         Float            @default(1.0)
  costPerLead       Float            @default(0.0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@map("facebook_insights")
}

model FacebookAdAccount {
  id                String          @id @default(uuid()) @db.Uuid
  facebookAccountId String          @db.Uuid
  facebookAccount   FacebookAccount @relation(fields: [facebookAccountId], references: [id], onDelete: Cascade)
  adAccountId       String          @unique
  name              String
  currency          String          @default("USD")
  timezone          String          @default("America/Los_Angeles")
  spend             Float           @default(0.0)
  reach             Int             @default(0)
  ctr               Float           @default(0.0)
  leadsCount        Int             @default(0)
  cpl               Float           @default(0.0)
  status            String          @default("ACTIVE")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  @@map("facebook_ad_accounts")
}

model FacebookAdSet {
  id                 String            @id @default(uuid()) @db.Uuid
  facebookCampaignId String?           @db.Uuid
  facebookCampaign   FacebookCampaign? @relation(fields: [facebookCampaignId], references: [id], onDelete: Cascade)
  adSetId            String            @unique
  name               String
  dailyBudget        Float             @default(0.0)
  lifetimeBudget     Float             @default(0.0)
  spend              Float             @default(0.0)
  reach              Int               @default(0)
  ctr                Float             @default(0.0)
  leadsCount         Int               @default(0)
  cpl                Float             @default(0.0)
  status             String            @default("ACTIVE")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  @@map("facebook_ad_sets")
}







